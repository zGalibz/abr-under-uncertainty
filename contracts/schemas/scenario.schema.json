{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-hls.local/schemas/scenario.schema.json",
  "title": "Adaptive HLS bandwidth scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "description",
    "clock",
    "rateUnit",
    "responseStartDelayMs",
    "scheduler",
    "phases"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "status": {"enum": ["draft", "frozen"]},
    "clock": {"const": "server-monotonic-since-run-start"},
    "rateUnit": {"const": "decimal-kbit-per-second"},
    "responseStartDelayMs": {"type": "integer", "minimum": 0, "maximum": 10000},
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "discipline", "initialTokensBytes", "maxBurstBytes", "maxChunkBytes"],
      "properties": {
        "scope": {"const": "per-run-aggregate-media-body"},
        "discipline": {"const": "work-conserving-fifo"},
        "initialTokensBytes": {"const": 0},
        "maxBurstBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maxChunkBytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/phase"}
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startMs", "downlinkKbps"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
        "startMs": {"type": "integer", "minimum": 0},
        "endMs": {"type": "integer", "exclusiveMinimum": 0},
        "downlinkKbps": {"type": "integer", "minimum": 1, "maximum": 10000000}
      }
    }
  }
}
