{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-hls.local/schemas/media-package.schema.json",
  "title": "Validated HLS media package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetId", "source", "toolchain", "packaging", "masterPlaylist", "masterSha256", "durationSeconds", "renditions", "files"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "assetId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "durationSeconds", "width", "height", "frameRate", "videoCodec", "audioCodec", "audioSampleRate", "audioChannels", "licenseClaim"],
      "properties": {
        "path": {"const": "assets/source/source.mp4"}, "sha256": {"$ref": "#/$defs/sha256"},
        "durationSeconds": {"type": "number", "exclusiveMinimum": 0}, "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}, "frameRate": {"type": "string"},
        "videoCodec": {"type": "string"}, "audioCodec": {"type": "string"},
        "audioSampleRate": {"type": "integer", "minimum": 1}, "audioChannels": {"type": "integer", "minimum": 1},
        "licenseClaim": {"type": "string", "minLength": 1}
      }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false, "required": ["ffmpeg", "ffprobe", "node"],
      "properties": {"ffmpeg": {"type": "string"}, "ffprobe": {"type": "string"}, "node": {"type": "string"}}
    },
    "packaging": {
      "type": "object", "additionalProperties": false,
      "required": ["commandArgs", "commandSha256", "frameRate", "segmentDurationSeconds", "gopFrames", "audioBitrateBps", "audioSampleRate"],
      "properties": {
        "commandArgs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "commandSha256": {"$ref": "#/$defs/sha256"}, "frameRate": {"const": "30/1"},
        "segmentDurationSeconds": {"const": 2}, "gopFrames": {"const": 60},
        "audioBitrateBps": {"const": 96000}, "audioSampleRate": {"const": 48000}
      }
    },
    "masterPlaylist": {"const": "master.m3u8"}, "masterSha256": {"$ref": "#/$defs/sha256"},
    "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
    "renditions": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/rendition"}
    },
    "files": {
      "type": "object", "minProperties": 9,
      "propertyNames": {"pattern": "^(master\\.m3u8|v[0-3]/(?:index\\.m3u8|seg_[0-9]{5}\\.ts))$"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "uri", "bytes", "extinfSeconds", "rateBps", "firstVideoPts90k", "firstVideoDts90k", "frameCount", "firstFrameKey", "firstVclNalType", "sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0}, "uri": {"type": "string", "pattern": "^v[0-3]/seg_[0-9]{5}\\.ts$"},
        "bytes": {"type": "integer", "minimum": 1}, "extinfSeconds": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "rateBps": {"type": "integer", "minimum": 1}, "firstVideoPts90k": {"type": "integer"},
        "firstVideoDts90k": {"type": "integer"}, "frameCount": {"type": "integer", "minimum": 1},
        "firstFrameKey": {"const": true}, "firstVclNalType": {"const": 5}, "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rendition": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "width", "height", "targetVideoBps", "measuredPeakBps", "measuredAverageBps", "codecs", "playlist", "playlistSha256", "segmentCount", "segments"],
      "properties": {
        "id": {"enum": ["v0", "v1", "v2", "v3"]}, "width": {"type": "integer"}, "height": {"type": "integer"},
        "targetVideoBps": {"type": "integer", "minimum": 1}, "measuredPeakBps": {"type": "integer", "minimum": 1},
        "measuredAverageBps": {"type": "integer", "minimum": 1}, "codecs": {"type": "string", "minLength": 1},
        "playlist": {"type": "string", "pattern": "^v[0-3]/index\\.m3u8$"}, "playlistSha256": {"$ref": "#/$defs/sha256"},
        "segmentCount": {"type": "integer", "minimum": 1}, "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}}
      }
    }
  }
}
