    "maxChunkBytes": 4096
  },
  "phases": [
    {
      "id": "high",
      "startMs": 0,
      "endMs": 20000,
      "downlinkKbps": 7045
    },
    {
      "id": "v2-safe",
      "startMs": 20000,
      "endMs": 40000,
      "downlinkKbps": 4408
    },
    {
      "id": "v1-safe",
      "startMs": 40000,
      "endMs": 60000,
      "downlinkKbps": 2409
    },
    {
      "id": "v0-safe",
      "startMs": 60000,
      "endMs": 80000,
      "downlinkKbps": 1292
    },
    {
      "id": "severe",
      "startMs": 80000,
      "endMs": 100000,
      "downlinkKbps": 711
    },
    {
      "id": "recovery",
      "startMs": 100000,
      "downlinkKbps": 7045
    }
  ]
}
