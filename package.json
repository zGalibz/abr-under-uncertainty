{
  "name": "abr-under-uncertainty",
  "version": "0.1.0",
  "private": true,
  "description": "Controlled HLS adaptive-bitrate experiment under deterministic bandwidth changes",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:foundation": "node scripts/validate-foundation.mjs",
    "test:contracts": "node --test tests/contract/*.test.mjs",
    "test:media": "npm test -w @abr-lab/media-cli",
    "test:server": "npm test -w @abr-lab/shaper-server",
    "test": "npm run test:contracts && npm run test:media && npm run test:server",
    "media:package": "npm run package -w @abr-lab/media-cli --",
    "media:validate": "npm run validate -w @abr-lab/media-cli --",
    "scenarios:compile": "npm run scenarios:compile -w @abr-lab/shaper-server",
    "server": "npm run serve -w @abr-lab/shaper-server",
    "calibrate:scenarios": "npm run calibrate -w @abr-lab/shaper-server",
    "test:analysis": "node --test tests/contract/analysis-*.test.mjs",
    "fixtures:analysis": "node tests/fixtures/analysis/build-fixtures.mjs",
    "synthetic": "node packages/analysis/src/synthetic/simulate.mjs && node packages/analysis/src/analyze.mjs --raw results/synthetic/raw --out results/synthetic --order results/synthetic/run-order.json",
    "analyze": "node packages/analysis/src/analyze.mjs --raw results/raw --out results"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
